@model Restaurante.Models.Empleado
<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="Nombre" class="form-label fw-semibold"></label>
        <input asp-for="Nombre" class="form-control" maxlength="100" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Apellido" class="form-label fw-semibold"></label>
        <input asp-for="Apellido" class="form-control" maxlength="100" />
        <span asp-validation-for="Apellido" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Cargo" class="form-label fw-semibold"></label>
        <input asp-for="Cargo" class="form-control" maxlength="80" placeholder="Ej. Mesero, cajero o cocinero" />
        <span asp-validation-for="Cargo" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Telefono" class="form-label fw-semibold"></label>
        <input asp-for="Telefono" class="form-control" maxlength="8" placeholder="Ej. 70012345" />
        <span asp-validation-for="Telefono" class="text-danger"></span>
    </div>
</div>
