@model Restaurante.ViewModels.FacturasIndexViewModel
@{ ViewData["Title"] = "Facturas"; }
<link rel="stylesheet" href="~/css/facturas.css" asp-append-version="true" />
<section class="facturas">
<div class="dashboard-heading"><div><h1>Facturas</h1><p>Control de facturación y pagos del restaurante.</p></div><a asp-action="Create" class="btn factura-primary"><i class="bi bi-plus-lg"></i> Nueva factura</a></div>
<div class="row g-3 mb-4">
<div class="col-sm-6 col-xl-3"><div class="factura-card"><span>Total facturado</span><strong>Bs @Model.TotalFacturado.ToString("N2")</strong><small>Pagadas y pendientes · sin anuladas</small></div></div>
<div class="col-sm-6 col-xl-3"><div class="factura-card"><span>Facturas pagadas</span><strong>@Model.Pagadas</strong><small>Pagos registrados</small></div></div>
<div class="col-sm-6 col-xl-3"><div class="factura-card"><span>Facturas pendientes</span><strong>@Model.Pendientes</strong><small>Por cobrar</small></div></div>
<div class="col-sm-6 col-xl-3"><div class="factura-card"><span>Facturas anuladas</span><strong>@Model.Anuladas</strong><small>Historial conservado</small></div></div>
</div>
<div class="factura-panel">
<form method="get" class="row g-3 p-4">
<div asp-validation-summary="All" class="text-danger"></div>
<div class="col-lg-4"><label asp-for="Buscar" class="form-label">Número, cliente o pedido</label><input asp-for="Buscar" class="form-control" placeholder="Buscar factura…" /></div>
<div class="col-sm-6 col-lg-2"><label asp-for="Desde" class="form-label">Desde</label><input asp-for="Desde" type="date" class="form-control" /></div>
<div class="col-sm-6 col-lg-2"><label asp-for="Hasta" class="form-label">Hasta</label><input asp-for="Hasta" type="date" class="form-control" /></div>
<div class="col-lg-2"><label asp-for="Estado" class="form-label">Estado</label><select asp-for="Estado" asp-items="Html.GetEnumSelectList<EstadoFactura>()" class="form-select"><option value="">Todos</option></select></div>
<div class="col-lg-2 d-flex align-items-end gap-2"><button class="btn factura-primary">Filtrar</button><a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a></div>
</form>
<div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>ID</th><th>Fecha</th><th>Pedido</th><th>Cliente</th><th>Subtotal</th><th>Impuestos</th><th>Total</th><th>Estado</th><th>Acciones</th></tr></thead><tbody>
@if (Model.Facturas.Count == 0) { <tr><td colspan="9" class="text-center py-5">No hay facturas que coincidan con los filtros.</td></tr> }
@foreach (var f in Model.Facturas) {
<tr><td>#@f.ID_Factura</td><td>@f.Fecha.ToString("dd/MM/yyyy HH:mm")</td><td><a asp-controller="Pedidos" asp-action="Details" asp-route-id="@f.ID_Pedido">#@f.ID_Pedido</a></td><td>@(f.Pedido.Cliente?.NombreCompleto ?? "Sin cliente")</td><td>@f.Subtotal.ToString("N2")</td><td>@f.Impuestos.ToString("N2")</td><td class="fw-bold">Bs @f.Total.ToString("N2")</td><td><span class="factura-estado">@f.Estado</span></td><td><div class="d-flex gap-2 flex-wrap">
<a asp-action="Details" asp-route-id="@f.ID_Factura" class="btn btn-sm btn-outline-secondary">Detalles</a>
<a asp-action="Details" asp-route-id="@f.ID_Factura" asp-route-imprimir="true" class="btn btn-sm btn-outline-secondary">Imprimir</a>
@if (f.Estado == EstadoFactura.Pendiente) {
<form asp-action="Pagar" asp-route-id="@f.ID_Factura" method="post"><button class="btn btn-sm factura-primary">Marcar pagada</button></form>
<a asp-action="Anular" asp-route-id="@f.ID_Factura" class="btn btn-sm btn-outline-danger">Anular</a>
}
</div></td></tr>
}
</tbody></table></div>
<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 p-4"><span>@Model.Cantidad facturas · importes en Bs</span><nav class="d-flex gap-3 align-items-center" aria-label="Paginación">
@if (Model.Pagina > 1) { <a asp-action="Index" asp-route-pagina="@(Model.Pagina-1)" asp-route-buscar="@Model.Buscar" asp-route-desde="@Model.Desde?.ToString("yyyy-MM-dd")" asp-route-hasta="@Model.Hasta?.ToString("yyyy-MM-dd")" asp-route-estado="@Model.Estado" class="btn btn-outline-secondary">Anterior</a> } else { <button disabled class="btn btn-outline-secondary">Anterior</button> }
<span>Página @Model.Pagina de @Model.Paginas</span>
@if (Model.Pagina < Model.Paginas) { <a asp-action="Index" asp-route-pagina="@(Model.Pagina+1)" asp-route-buscar="@Model.Buscar" asp-route-desde="@Model.Desde?.ToString("yyyy-MM-dd")" asp-route-hasta="@Model.Hasta?.ToString("yyyy-MM-dd")" asp-route-estado="@Model.Estado" class="btn btn-outline-secondary">Siguiente</a> } else { <button disabled class="btn btn-outline-secondary">Siguiente</button> }
</nav></div></div></section>
