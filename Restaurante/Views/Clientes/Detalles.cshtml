@model Restaurante.Models.Cliente

@{
    ViewData["Title"] = "Detalles del cliente";
}

<div class="mb-4">
    <h1 class="fw-bold">Detalles del cliente</h1>
    <p class="text-muted">Información del cliente seleccionado.</p>
</div>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3">
        <h5 class="mb-0">Información personal</h5>
    </div>

    <div class="card-body p-4">
        <dl class="row mb-0">
            <dt class="col-sm-3">ID</dt>
            <dd class="col-sm-9">@Model.ID_Cliente</dd>

            <dt class="col-sm-3">Nombre</dt>
            <dd class="col-sm-9">@Model.Nombre</dd>

            <dt class="col-sm-3">Apellido</dt>
            <dd class="col-sm-9">@Model.Apellido</dd>

            <dt class="col-sm-3">Teléfono</dt>
            <dd class="col-sm-9">@Model.Telefono</dd>

            <dt class="col-sm-3">Correo</dt>
            <dd class="col-sm-9 text-break">@Model.Correo</dd>

            <dt class="col-sm-3">Dirección</dt>
            <dd class="col-sm-9">@Model.Direccion</dd>
        </dl>
    </div>

    <div class="card-body border-top p-4">
        <h5 class="mb-3">Pedidos de este cliente</h5>
        @if (Model.Pedidos.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>N.º</th>
                            <th>Fecha</th>
                            <th>Mesa</th>
                            <th>Total</th>
                            <th>Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var pedido in Model.Pedidos)
                        {
                            <tr>
                                <td>
                                    <a asp-controller="Pedidos" asp-action="Details" asp-route-id="@pedido.ID_Pedido"
                                       class="enlace-dorado fw-semibold">#@pedido.ID_Pedido</a>
                                </td>
                                <td>@pedido.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>Mesa @pedido.Mesa?.Numero</td>
                                <td>Bs @pedido.Total.ToString("N2")</td>
                                <td><partial name="~/Views/Pedidos/_EstadoBadge.cshtml" model="pedido.Estado" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="text-muted mb-0">Este cliente todavía no tiene pedidos.</p>
        }
    </div>

    <div class="card-footer bg-white py-3">
        <a href="@Url.Action("Index", "Clientes")"
           class="btn btn-outline-secondary">
            Volver a clientes
        </a>
    </div>
</div>